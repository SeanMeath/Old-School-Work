#!/bin/bash

a=$(cat /proc/cpuinfo | grep '^model name' | uniq | awk -F':' '{ print $2 }' | tr -s ' ' | tr '\t' ' ')
b=$(cat /proc/cpuinfo | grep 'cache' | uniq | sed -n '1p' | awk -F':' '{ print $2 }')
c=$(cat /proc/cpuinfo | grep 'processor' | tail -n 1 | awk -F':' '{ print $2 }')
c=$(($c+1))
echo "CPU:$a, cache:$b, number of cores:$c"