    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="A" type="Integer" array="False" size="" variables="A"/>
            <output expression="&quot;INPUT NUMB&quot;"/>
            <input variable="A"/>
            <declare name="B" type="Integer" array="False" size="" variables="B"/>
            <for variable="B" start="A-1" end="1" direction="dec" step="1">
                <assign variable="A" expression="A*B"/>
            </for>
            <output expression="A"/>
        </body>
    </function>
