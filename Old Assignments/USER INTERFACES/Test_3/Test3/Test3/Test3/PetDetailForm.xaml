<Window x:Class="Test3.PetDetailForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Test3"
        mc:Ignorable="d"
        Title="PetDetailForm" Height="600" Width="300">
    <StackPanel Margin="10">
        <TextBlock Margin="10,10,30,10" FontFamily="Harlow Solid Italic" FontSize="22" TextAlignment="Center"><Run Text="Pet Details"/></TextBlock>

        <TextBlock Margin="0,20,0,0">Name</TextBlock>
        <TextBox Name="txtName" IsReadOnly="True" ></TextBox>

        <TextBlock Margin="0,10,0,0">Age</TextBlock>
        <TextBox Name="txtAge" IsReadOnly="True" ></TextBox>

        <TextBlock Margin="0,10,0,0">Gender</TextBlock>
        <TextBox Name="txtGender" IsReadOnly="True" ></TextBox>

        <TextBlock Margin="0,10,0,0">Neutered</TextBlock>
        <TextBox Name="txtNeutered" IsReadOnly="True" ></TextBox>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Name="btnAdopt" Margin="0,20,4.667,0" Click="btnAdopt_Click" Height="20" VerticalAlignment="Top">Adopt?</Button>
            <Button Name="btnCancel" Margin="5,20,0,0" Grid.Column="1" Click="btnCancel_Click">Cancel</Button>
        </Grid>
    </StackPanel>
</Window>
