<Window x:Class="Test3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Test3"
        mc:Ignorable="d"
        Title="Test3" Height="400" Width="725">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        
        <!-- Part 2 -->
        <StackPanel Grid.Row="0" Margin="10">
            <TextBlock Margin="10" FontFamily="Harlow Solid Italic" FontSize="22" TextAlignment="Center">Copy Text Files (Part 2)</TextBlock>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <TextBlock Margin="3" Width="80" TextAlignment="Right"> Original File</TextBlock>
                <TextBox Name="tbOriginalFile" Margin="3" Grid.Column="1" IsReadOnly="True" TextAlignment="Left"></TextBox>
                <Button Click="btnOriginalFile_Click" Name="btnOriginalFile" Margin="3.333,3,2.667,1" Grid.Column="2">...</Button>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <TextBlock Margin="3" Width="80" TextAlignment="Right"> Copy To</TextBlock>
                <TextBox Name="tbSaveToFile" Margin="3" Grid.Column="1" IsReadOnly="True" TextAlignment="Left"></TextBox>
                <Button Click="btnSaveToFile_Click" Name="btnSaveToFile" Margin="3" Grid.Column="2">...</Button>
            </Grid>
            <Button Click="btnCopyFile_Click" Name="btnCopyFile" Margin="3">Copy File</Button>
            <TextBlock Name="txtStatus" Margin="3" Background="BlanchedAlmond"></TextBlock>

        </StackPanel>

        <!-- Part 3 -->
        <StackPanel Grid.Row="2" Margin="10">
            <TextBlock Margin="10" FontFamily="Harlow Solid Italic" FontSize="22" TextAlignment="Center">Adopt a Pet (Part 3)</TextBlock>
 
                <Button Name="btnAdopt" Margin="3"  Width="80"  Click="btnAdopt_Click">Click Here</Button>
         
        </StackPanel>
    </Grid>
</Window>
