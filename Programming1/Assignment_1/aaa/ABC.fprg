<?xml version="1.0"?>
<flowgorithm fileversion="2.6">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="paul"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2017-09-22 09:57:08 PM"/>
        <attribute name="created" value="cGF1bDsgUEFVTC1QQzsgMjAxNy0wOS0xNDsgMDg6MzU6MjYgUE07IDIzMjA="/>
        <attribute name="edited" value="U2VhbiBNZWF0aDsgREVTS1RPUC1EMVRUMDJVOyAyMDE3LTA5LTIyOyAwOTo1NzowOCBQTTsgMzM2MQ=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a" type="Real" array="False" size=""/>
            <declare name="b" type="Real" array="False" size=""/>
            <declare name="c" type="Real" array="False" size=""/>
            <declare name="numb" type="Real" array="False" size=""/>
            <assign variable="numb" expression="10"/>
            <output expression="&quot;Please input a number for a&quot;"/>
            <input variable="a"/>
            <if expression="a &lt; numb">
                <then>
                    <assign variable="b" expression="0"/>
                    <assign variable="c" expression="1"/>
                </then>
                <else>
                    <assign variable="b" expression="1"/>
                    <assign variable="c" expression="0"/>
                </else>
            </if>
            <output expression="&quot;a=&quot; &amp; a &amp; &quot;, b=&quot; &amp; b &amp; &quot;, c=&quot; &amp; c"/>
        </body>
    </function>
</flowgorithm>
